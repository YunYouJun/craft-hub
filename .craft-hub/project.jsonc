{
  "$schema": "https://raw.githubusercontent.com/YunYouJun/craft-hub/main/packages/craft-hub/schema/project-v1.schema.json",
  "version": 1,
  "project": {
    "name": "Craft Hub"
  },
  "capabilities": {
    "descriptions": {
      "package.json:build": {
        "default": "Build every workspace package.",
        "zh-CN": "构建所有工作区包。"
      },
      "package.json:dev": {
        "default": "Start the runtime, web app, and Electron shell in development mode.",
        "zh-CN": "以开发模式启动运行时、Web 应用和 Electron 桌面端。"
      },
      "package.json:dev:web": {
        "default": "Start the runtime and browser-based workbench for local development.",
        "zh-CN": "启动运行时和浏览器工作台进行本地开发。"
      },
      "package.json:lint": {
        "default": "Check the workspace with ESLint.",
        "zh-CN": "使用 ESLint 检查工作区。"
      },
      "package.json:package:mac": {
        "default": "Package the Electron desktop app for macOS.",
        "zh-CN": "打包适用于 macOS 的 Electron 桌面应用。"
      },
      "package.json:predocs": {
        "default": "Generate API reference documentation with TypeDoc.",
        "zh-CN": "使用 TypeDoc 生成 API 参考文档。"
      },
      "package.json:prepare": {
        "default": "Install the repository Git hooks.",
        "zh-CN": "安装仓库 Git 钩子。"
      },
      "package.json:prepublishOnly": {
        "default": "Build all packages before publishing.",
        "zh-CN": "在发布前构建所有包。"
      },
      "package.json:docs:dev": {
        "default": "Start the documentation site in development mode.",
        "zh-CN": "以开发模式启动文档站点。"
      },
      "package.json:docs:build": {
        "default": "Build packages, API references, and the documentation site.",
        "zh-CN": "构建包、API 参考文档和文档站点。"
      },
      "package.json:docs:preview": {
        "default": "Preview the generated documentation site.",
        "zh-CN": "预览生成的文档站点。"
      },
      "package.json:prototype:plugin-ui": {
        "default": "Open the plugin UI prototype in Vite.",
        "zh-CN": "使用 Vite 打开插件界面原型。"
      },
      "package.json:test": {
        "default": "Run the workspace test suite with Vitest.",
        "zh-CN": "使用 Vitest 运行工作区测试套件。"
      },
      "package.json:typecheck": {
        "default": "Type-check the complete TypeScript workspace.",
        "zh-CN": "对整个 TypeScript 工作区进行类型检查。"
      },
      "package.json:release": {
        "default": "Prepare version bumps and publish workspace packages.",
        "zh-CN": "准备版本更新并发布工作区包。"
      },
      "package.json:schema:project": {
        "default": "Regenerate the versioned project configuration JSON Schema.",
        "zh-CN": "重新生成版本化的项目配置 JSON Schema。"
      },
      "package.json:schema:project:check": {
        "default": "Verify that the checked-in project configuration schema matches its Zod source.",
        "zh-CN": "检查已提交的项目配置 Schema 是否与 Zod 源定义一致。"
      }
    }
  }
}
