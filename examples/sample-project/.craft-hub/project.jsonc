{
  "$schema": "https://raw.githubusercontent.com/YunYouJun/craft-hub/main/packages/craft-hub/schema/project-v1.schema.json",
  "version": 1,
  "project": {
    "name": "Sample Project",
    "icon": "emoji:🧰",
    "color": "purple"
  },
  "defaults": {
    "agent": "codex"
  },
  "capabilities": {
    "hidden": [],
    "descriptions": {
      "package.json:hello": {
        "default": "Print a greeting from the sample project.",
        "zh-CN": "打印来自示例项目的问候。"
      },
      "package.json:stream": {
        "default": "Demonstrate live output from a running command.",
        "zh-CN": "演示运行命令的实时输出。"
      },
      "package.json:terminal": {
        "default": "Demonstrate ANSI colors, links, and interactive PTY input.",
        "zh-CN": "演示 ANSI 颜色、链接和交互式 PTY 输入。"
      },
      "package.json:verify": {
        "default": "Run the sample project checks.",
        "zh-CN": "运行示例项目检查。"
      }
    },
    "skillInputs": {
      "agent-skill:release": {
        "channel": {
          "type": "select",
          "label": {
            "default": "Release channel",
            "zh-CN": "发布渠道"
          },
          "options": [
            {
              "value": "stable",
              "label": {
                "default": "Stable",
                "zh-CN": "正式版"
              }
            },
            {
              "value": "canary",
              "label": {
                "default": "Canary",
                "zh-CN": "预览版"
              }
            }
          ],
          "default": "stable",
          "required": true
        },
        "version": {
          "type": "select",
          "label": {
            "default": "Version type",
            "zh-CN": "版本类型"
          },
          "options": ["patch", "minor"],
          "default": "patch"
        }
      }
    }
  }
}
