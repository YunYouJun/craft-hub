    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@craft-hub/craft-hub-plugin-microsoft-todo": ["./packages/craft-hub-plugin-microsoft-todo/src/index.ts"],
      "@craft-hub/craft-hub-plugin-workstation": ["./packages/craft-hub-plugin-workstation/src/index.ts"],
      "craft-hub/marketplace-model": ["./packages/craft-hub/src/marketplace-model.ts"],
      "craft-hub/configuration-management": ["./packages/craft-hub/src/configuration-management.ts"],
      "craft-hub/integration-form-inputs": ["./packages/craft-hub/src/integration-form-inputs.ts"],
      "craft-hub": ["./packages/craft-hub/src/index.ts"],
      "craft-hub/personal-workbench": ["./packages/craft-hub/src/personal-workbench.ts"],
      "craft-hub/quick-capture": ["./packages/craft-hub/src/quick-capture.ts"],
      "craft-hub/work-items": ["./packages/craft-hub/src/work-items.ts"],
      "craft-hub/project-config-schema-revision": ["./packages/craft-hub/src/project-config-schema-revision.ts"],
      "craft-hub/skill-inputs": ["./packages/craft-hub/src/skill-inputs.ts"],
