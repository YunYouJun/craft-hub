{
  "name": "craft-hub-workspace",
  "type": "module",
  "version": "0.0.1-alpha.5",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "build": "pnpm software-catalog:check && nr -r build && node packages/craft-hub/scripts/prepare-package.mjs",
    "build:mac": "pnpm build && pnpm run package:mac",
    "build:tauri": "pnpm build && pnpm --filter @craft-hub/tauri-trial build:trial",
    "dev": "tsx scripts/dev-environment.ts desktop",
    "dev:web": "node --import tsx scripts/dev-environment.ts web",
    "dev:tauri": "pnpm --filter @craft-hub/tauri-trial dev:trial",
    "check:public-boundary": "node scripts/check-public-boundary.mjs",
    "lint": "pnpm check:public-boundary && eslint --cache .",
    "package:mac": "tsx scripts/run-package-macos.ts",
    "reinstall:mac": "tsx scripts/reinstall-macos.ts",
    "prepublishOnly": "nr build",
    "predocs": "typedoc",
    "docs:dev": "pnpm -C docs run docs:dev",
    "docs:build": "pnpm build && pnpm predocs && pnpm -C docs run docs:build",
    "docs:preview": "pnpm -C docs run docs:preview",
    "release": "bumpp -r",
    "schema:project": "tsx scripts/generate-project-config-schema.ts",
    "schema:project:check": "tsx scripts/generate-project-config-schema.ts --check",
    "software-catalog:sync": "tsx scripts/sync-software-catalog.ts",
    "software-catalog:check": "tsx scripts/sync-software-catalog.ts --check",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@antfu/ni": "catalog:",
    "@antfu/utils": "catalog:",
    "@electron/packager": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "bumpp": "catalog:",
    "craft-hub": "workspace:*",
    "eslint": "catalog:",
    "lint-staged": "catalog:",
    "publint": "catalog:",
    "simple-git-hooks": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typedoc": "catalog:",
    "typedoc-plugin-markdown": "catalog:",
    "typedoc-vitepress-theme": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
