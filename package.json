{
  "name": "craft-hub-workspace",
  "type": "module",
  "version": "0.0.1-alpha.7",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || ^26.0.0"
  },
  "scripts": {
    "build": "pnpm software-catalog:check && nr -r build && node packages/craft-hub/scripts/prepare-package.mjs",
    "build:mac": "pnpm build && pnpm run package:mac",
    "build:macos": "tsx apps/macos/scripts/build-app.ts",
    "benchmark:macos": "tsx scripts/benchmark-desktop-macos.ts",
    "dev": "tsx scripts/dev-environment.ts desktop",
    "dev:web": "node --import tsx scripts/dev-environment.ts web",
    "check:public-boundary": "node scripts/check-public-boundary.mjs",
    "icons:desktop": "tsx scripts/generate-desktop-icons.ts",
    "lint": "pnpm check:public-boundary && eslint --cache .",
    "lint:macos": "swift format lint --strict --configuration apps/macos/.swift-format --recursive apps/macos/Sources apps/macos/Tests apps/macos/Package.swift",
    "format:macos": "swift format format --in-place --configuration apps/macos/.swift-format --recursive apps/macos/Sources apps/macos/Tests apps/macos/Package.swift",
    "package:mac": "tsx scripts/run-package-macos.ts",
    "package:macos": "tsx apps/macos/scripts/package-release.ts",
    "reinstall:mac": "tsx scripts/reinstall-macos.ts",
    "prepublishOnly": "nr build",
    "predocs": "typedoc",
    "docs:dev": "pnpm -C docs run docs:dev",
    "docs:build": "pnpm build && pnpm predocs && pnpm -C docs run docs:build",
    "docs:preview": "pnpm -C docs run docs:preview",
    "release": "bumpp -r",
    "repo:validate": "tsx packages/craft-hub/src/cli.ts repo:validate",
    "schema:project": "tsx scripts/generate-project-config-schema.ts",
    "schema:project:check": "tsx scripts/generate-project-config-schema.ts --check",
    "schema:source": "tsx scripts/generate-workspace-source-schema.ts",
    "schema:source:check": "tsx scripts/generate-workspace-source-schema.ts --check",
    "software-catalog:sync": "tsx scripts/sync-software-catalog.ts",
    "software-catalog:check": "tsx scripts/sync-software-catalog.ts --check",
    "test": "vitest",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:macos-updates": "tsx apps/macos/scripts/verify-updates.ts",
    "test:macos-configuration": "tsx apps/macos/scripts/verify-configuration.ts",
    "test:macos-management": "tsx apps/macos/scripts/verify-management.ts",
    "test:macos-host-extensions": "tsx apps/macos/scripts/verify-host-extensions.ts",
    "test:macos-migration": "tsx apps/macos/scripts/verify-profile-migration.ts",
    "test:macos-instance": "tsx apps/macos/scripts/verify-native-instance.ts",
    "test:macos-identity-source": "tsx apps/macos/scripts/verify-identity-source.ts",
    "test:macos-identity-recipient": "tsx apps/macos/scripts/verify-identity-recipient.ts",
    "test:identity-launcher": "tsx scripts/verify-identity-launcher.ts",
    "test:desktop-backend": "tsx scripts/verify-desktop-backend.ts",
    "typecheck": "tsc --noEmit",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@antfu/ni": "catalog:",
    "@antfu/utils": "catalog:",
    "@electron/fuses": "catalog:",
    "@electron/packager": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "bumpp": "catalog:",
    "craft-hub": "workspace:*",
    "eslint": "catalog:",
    "lint-staged": "catalog:",
    "node-api-headers": "catalog:",
    "playwright": "catalog:",
    "publint": "catalog:",
    "simple-git-hooks": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typedoc": "catalog:",
    "typedoc-plugin-markdown": "catalog:",
    "typedoc-vitepress-theme": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
