{
  "name": "craft-hub",
  "type": "module",
  "version": "0.0.1-alpha.9",
  "private": false,
  "description": "A local, cross-project workbench for project commands and agent skills.",
  "author": "YunYouJun",
  "license": "MIT",
  "funding": "https://github.com/sponsors/YunYouJun",
  "homepage": "https://github.com/YunYouJun/craft-hub#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YunYouJun/craft-hub.git"
  },
  "bugs": "https://github.com/YunYouJun/craft-hub/issues",
  "keywords": [
    "developer-tools",
    "command-palette",
    "agent-skills"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./cli": "./dist/cli.mjs",
    "./command-inputs": "./dist/command-inputs.mjs",
    "./project-config-schema-revision": "./dist/project-config-schema-revision.mjs",
    "./skill-inputs": "./dist/skill-inputs.mjs",
    "./skill-prompts": "./dist/skill-prompts.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "bin": {
    "craft-hub": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --no-clean",
    "dev:server": "tsx src/cli.ts ui",
    "prepack": "nr build",
    "start": "tsx src/cli.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "cac": "catalog:",
    "chokidar": "catalog:",
    "cross-spawn": "catalog:",
    "jsonc-parser": "catalog:",
    "node-pty": "catalog:",
    "pacote": "catalog:",
    "semver": "catalog:",
    "tinyglobby": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/pacote": "catalog:",
    "@types/semver": "catalog:"
  }
}
