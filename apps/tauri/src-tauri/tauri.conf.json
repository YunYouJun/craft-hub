{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Craft Hub Tauri Trial",
  "version": "0.0.1-alpha.5",
  "identifier": "dev.craft-hub.tauri-trial",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "capabilities": [],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data: https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["../../desktop/assets/icon.png", "../../desktop/assets/icon.icns"],
    "resources": {
      "../.prepared/backend/": "backend/"
    },
    "macOS": {
      "minimumSystemVersion": "13.5",
      "signingIdentity": "-"
    }
  }
}
